{
  "name": "commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm env:check && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:rule:test": "node --test scripts/lint/analytics-rule.test.mjs",
    "commit:test": "node --test scripts/commit/check-message.test.mjs",
    "commit:check": "node scripts/commit/check-message.mjs",
    "ci:test": "node --test scripts/ci/decide-e2e.test.mjs",
    "ci:audit": "python3 scripts/ci/audit_ci.py",
    "ci:audit:test": "python3 scripts/ci/audit_ci_test.py",
    "style:check": "python3 scripts/style/check_korean_style.py",
    "style:test": "python3 scripts/style/check_korean_style_test.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=unit --project=dom",
    "test:watch": "vitest --project=unit --project=dom",
    "test:storybook": "vitest run --project=storybook",
    "test:e2e": "APP_ORIGIN=http://127.0.0.1:3000 pnpm build && pnpm test:e2e:prebuilt",
    "test:e2e:prebuilt": "playwright test",
    "test:smoke": "playwright test --config=playwright.smoke.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "env:check": "node scripts/validate-env.mjs",
    "env:test": "node --test scripts/validate-env.test.mjs",
    "size:check": "node scripts/size/route-bundle.mjs",
    "size:baseline": "node scripts/size/route-bundle.mjs --update-baseline",
    "size:test": "node --test scripts/size/route-bundle.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analytics:funnel": "node scripts/analytics/funnel.mjs",
    "architecture:check": "node scripts/architecture/review.mjs",
    "architecture:check:staged": "node scripts/architecture/review.mjs --staged",
    "architecture:evidence": "node scripts/architecture/review.mjs --json",
    "architecture:test": "node --test scripts/architecture/review.test.mjs",
    "check:local": "pnpm architecture:check && pnpm architecture:test && pnpm test && pnpm test:storybook && pnpm lint:rule:test && pnpm commit:test && pnpm ci:test && pnpm ci:audit:test && pnpm ci:audit && pnpm style:test && pnpm style:check && pnpm lint && pnpm typecheck",
    "check": "pnpm architecture:check && pnpm test && pnpm test:storybook && pnpm lint:rule:test && pnpm commit:test && pnpm ci:test && pnpm ci:audit:test && pnpm ci:audit && pnpm style:test && pnpm style:check && pnpm lint && pnpm typecheck && pnpm env:test && APP_ORIGIN=http://127.0.0.1:3000 pnpm env:check && pnpm size:test && APP_ORIGIN=http://127.0.0.1:3000 pnpm build && pnpm size:check && pnpm build:storybook && pnpm test:e2e:prebuilt",
    "prepare": "husky",
    "check:hero": "node scripts/measure/gate.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "next": "16.2.10",
    "nuqs": "^2.9.0",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.14"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored",
      "prettier --write"
    ],
    "*.{css,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/env": "16.2.10",
    "@next/eslint-plugin-next": "16.2.10",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.5",
    "@storybook/addon-vitest": "^10.5.5",
    "@storybook/nextjs-vite": "^10.5.5",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.15.0",
    "playwright": "^1.62.1",
    "prettier": "^3.8.4",
    "storybook": "^10.5.5",
    "typescript": "^5",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.10"
  }
}
