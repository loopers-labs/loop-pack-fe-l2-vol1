{
  "name": "commerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "dev:e2e": "pnpm e2e:build && concurrently -k -n mock,next \"pnpm e2e:mock-api\" \"pnpm e2e:start\"",
    "build": "next build",
    "e2e:build": "INTERNAL_API_BASE_URL=http://127.0.0.1:4010 NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4010 pnpm build",
    "e2e:mock-api": "MOCK_API_PORT=4010 node e2e/mock-api/server.mjs",
    "e2e:start": "INTERNAL_API_BASE_URL=http://127.0.0.1:4010 NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:4010 pnpm start --hostname 127.0.0.1 --port 3000",
    "start": "next start",
    "prepare": "husky",
    "lint": "eslint .",
    "architecture:check": "vitest run fsdImportBoundaries",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:mock-api": "node --test e2e/mock-api/server.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:mutation": "stryker run",
    "test:watch": "vitest",
    "format:check": "prettier --check .",
    "check": "pnpm test && pnpm lint && pnpm typecheck && pnpm build && pnpm test:e2e"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-query-devtools": "^5.101.2",
    "next": "16.2.10",
    "nuqs": "^2.9.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-error-boundary": "^6.1.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "msw": "^2.15.0",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
