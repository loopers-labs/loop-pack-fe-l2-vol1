# Required in CI/production
APP_ORIGIN=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-at-least-16-characters

# Optional server-only override for server-to-server API calls
INTERNAL_API_BASE_URL=

# Optional browser-exposed API origin. Do not put secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_BASE_URL=

# Optional performance/test scenario
NEXT_PUBLIC_HOME_API_SCENARIO=
