{
  "permissions": {
    "deny": [
      "Edit(eslint.config.mjs)",
      "Edit(tsconfig.json)",
      "Edit(.prettierrc)",
      "Edit(.husky/**)",
      "Edit(.github/workflows/**)",
      "Edit(.claude/settings.json)",
      "Edit(.claude/settings.local.json)",
      "Edit(.claude/hooks/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-git-bypass.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
